// Ress-Amp panel display, drawn in the mockup's own coordinates (469 x 286).
// audioLow = (input level 0..1, output level 0..1, gate open 0..1, model 0..1)
// The left meter well shows the input, the right well the output.

uniform float4 audioLow;

const float W = 469.0;
const float H = 286.0;
const float SEGMENTS = 22.0;
const float TOP = 69.0;
const float BOTTOM = 189.0;

float3 meterColor(float t)
{
    if (t > 0.93) return float3(0.94, 0.35, 0.00);
    if (t > 0.80) return float3(0.96, 0.78, 0.09);
    return float3(0.55, 0.78, 0.11);
}

float inBox(float2 p, float2 a, float2 b)
{
    return (p.x > a.x && p.x < b.x && p.y > a.y && p.y < b.y) ? 1.0 : 0.0;
}

float frame(float2 p, float2 a, float2 b, float w)
{
    return inBox(p, a, b) - inBox(p, a + float2(w, w), b - float2(w, w));
}

float3 bar(float3 color, float2 p, float x0, float level)
{
    color = mix(color, float3(0.063, 0.071, 0.086),
                inBox(p, float2(x0, 10.0), float2(x0 + 13.0, 189.1)));
    if (p.y > TOP && p.y < BOTTOM && p.x > x0 && p.x < x0 + 13.0)
    {
        float step = (BOTTOM - TOP) / SEGMENTS;
        float slot = (BOTTOM - p.y) / step;
        float idx = floor(slot);
        float lit = clamp((level - (idx / SEGMENTS)) * SEGMENTS, 0.0, 1.0);
        float on = (mod(BOTTOM - p.y, step) < 1.6) ? 0.0 : 1.0;
        if (on > 0.5 && lit > 0.4)
            color = mix(color, meterColor((idx + 0.5) / SEGMENTS), lit);
    }
    return color;
}

half4 main(float2 fragCoord)
{
    float2 p = fragCoord / iResolution.xy * float2(W, H);

    float3 color = mix(float3(0.118, 0.133, 0.157), float3(0.086, 0.098, 0.118),
                       clamp(p.y / H, 0.0, 1.0));

    // ---- panel bodies -----------------------------------------------------
    float3 well = float3(0.071, 0.078, 0.094);
    float3 strip = float3(0.098, 0.110, 0.130);
    color = mix(color, well, inBox(p, float2(2.8, 3.9), float2(66.8, 196.9)));
    color = mix(color, well, inBox(p, float2(308.8, 4.9), float2(372.8, 197.9)));
    color = mix(color, well, inBox(p, float2(70.8, 3.9), float2(303.8, 196.9)));
    color = mix(color, strip, inBox(p, float2(1.8, 199.9), float2(373.8, 282.9)));
    color = mix(color, strip, inBox(p, float2(377.8, 5.9), float2(465.8, 282.9)));

    float e = 0.66;
    float3 dark = float3(0.020, 0.020, 0.020);
    color -= dark * frame(p, float2(2.8, 3.9), float2(66.8, 196.9), e);
    color -= dark * frame(p, float2(308.8, 4.9), float2(372.8, 197.9), e);
    color -= dark * frame(p, float2(70.8, 3.9), float2(303.8, 196.9), e);
    color -= dark * frame(p, float2(1.8, 199.9), float2(373.8, 282.9), e);
    color -= dark * frame(p, float2(377.8, 5.9), float2(465.8, 282.9), e);

    // ---- meters: input on the left, output on the right ------------------
    color = bar(color, p, 20.8, audioLow.x);
    color = bar(color, p, 35.8, audioLow.x);
    color = bar(color, p, 326.8, audioLow.y);
    color = bar(color, p, 341.8, audioLow.y);

    // gate LED
    float r = length(p - float2(340.8, 40.0));
    color = mix(color, float3(0.24, 0.78, 0.62), clamp(audioLow.z, 0.0, 1.0) * step(r, 2.4));

    return half4(color, 1.0);
}
