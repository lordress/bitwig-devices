// Ress-Amp panel shader.
// Generated by gen_panel.py from panel_spec.py + panel_body.sksl; edit those.
// Design pixels: one grid unit is 469/87 px, the whole panel 469 x 286.
// audioLow = (input level 0..1, output level 0..1, gate open 0..1, model 0..1)
// Panel shader generated by bwui from the panel spec.
// Sections, meters and the background come from the spec; do not hand-edit the
// generated block, change the spec and regenerate.
uniform float4 audioLow;          // lanes: (in, out, gate, model) by convention

const float W = 469.0;
const float H = 285.7126;

float inBox(float2 p, float2 a, float2 b)
{
    return (p.x > a.x && p.x < b.x && p.y > a.y && p.y < b.y) ? 1.0 : 0.0;
}

float frame(float2 p, float2 a, float2 b, float w)
{
    return inBox(p, a, b) - inBox(p, a + float2(w, w), b - float2(w, w));
}

float3 meterColor(float t)
{
    if (t > 0.93) return float3(0.94, 0.35, 0.0);
    if (t > 0.80) return float3(0.96, 0.78, 0.09);
    return float3(0.55, 0.78, 0.11);
}

float3 meterBar(float3 color, float2 p, float2 a, float2 b, float level, float segments)
{
    color = mix(color, float3(0.063, 0.071, 0.086), inBox(p, a, b));
    float h = (b.y - a.y) / segments;
    if (p.y > a.y && p.y < b.y && p.x > a.x && p.x < b.x)
    {
        float slot = (b.y - p.y) / h;
        float idx = floor(slot);
        float lit = clamp((level - (idx / segments)) * segments, 0.0, 1.0);
        float on = (mod(b.y - p.y, h) < 1.6) ? 0.0 : 1.0;
        if (on > 0.5 && lit > 0.4)
            color = mix(color, meterColor((idx + 0.5) / segments), lit);
    }
    return color;
}

half4 main(float2 fragCoord)
{
    float2 p = fragCoord / iResolution.xy * float2(W, H);
    float3 color = mix(float3(0.118, 0.133, 0.157), float3(0.086, 0.098, 0.118), clamp(p.y / H, 0.0, 1.0));

    // ---- sections ----------------------------------------------------
    color = mix(color, float3(0.071, 0.078, 0.094), inBox(p, float2(2.8032, 3.8814), float2(66.7921, 196.5487)));
    color = mix(color, float3(0.071, 0.078, 0.094), inBox(p, float2(70.8352, 3.8814), float2(303.8797, 196.5487)));
    color = mix(color, float3(0.071, 0.078, 0.094), inBox(p, float2(308.8392, 4.9056), float2(372.828, 197.9503)));
    color = mix(color, float3(0.098, 0.11, 0.13), inBox(p, float2(1.779, 199.9449), float2(373.7445, 282.9633)));
    color = mix(color, float3(0.098, 0.11, 0.13), inBox(p, float2(377.8415, 5.876), float2(465.8733, 282.9094)));

    // section edges
    color -= float3(0.02, 0.02, 0.02) * frame(p, float2(2.8032, 3.8814), float2(66.7921, 196.5487), 0.66);
    color -= float3(0.02, 0.02, 0.02) * frame(p, float2(70.8352, 3.8814), float2(303.8797, 196.5487), 0.66);
    color -= float3(0.02, 0.02, 0.02) * frame(p, float2(308.8392, 4.9056), float2(372.828, 197.9503), 0.66);
    color -= float3(0.02, 0.02, 0.02) * frame(p, float2(1.779, 199.9449), float2(373.7445, 282.9633), 0.66);
    color -= float3(0.02, 0.02, 0.02) * frame(p, float2(377.8415, 5.876), float2(465.8733, 282.9094), 0.66);

    // ---- meters ------------------------------------------------------
    color = meterBar(color, p, float2(20.8085, 10.0269), float2(33.8003, 189.1633), audioLow.x, 22.0);
    color = meterBar(color, p, float2(35.7949, 10.0269), float2(48.7868, 189.1633), audioLow.x, 22.0);
    color = meterBar(color, p, float2(326.8445, 10.0269), float2(339.8363, 189.1633), audioLow.y, 22.0);
    color = meterBar(color, p, float2(341.8848, 10.0269), float2(354.8767, 189.1633), audioLow.y, 22.0);

    // ---- custom drawing ----------------------------------------------
    // Ress-Amp: the parts of the face the panel spec cannot describe.
    // Appended to the generated chrome, in the same design pixels (469 x 286).
    // audioLow = (input level, output level, gate open, model position)

    // The gate LED in the output well: lit while the gate is open.
    float r = length(p - float2(340.8, 40.0));
    color = mix(color, float3(0.24, 0.78, 0.62), clamp(audioLow.z, 0.0, 1.0) * step(r, 2.4));

    // A hairline between the two meter bars of each pair, so they read as one meter.
    color = mix(color, float3(0.043, 0.047, 0.055), inBox(p, float2(33.0, 10.0), float2(34.0, 189.1)));
    color = mix(color, float3(0.043, 0.047, 0.055), inBox(p, float2(339.0, 10.0), float2(340.0, 189.1)));

    return half4(color, 1.0);
}
